{
  "background": {
    "defaults": {
      "type": "background",
        "backgroundColor": "#ffffff",
        "backgroundImage": ""
    },
    "keys": ["backgroundColor", "backgroundImage"]
  },
  "overlay": {
    "defaults": {
      "type": "overlay"
    },
    "keys": ["overlayOpacity", "overlayColor", "overlayPatternHeight"]
  },
  "size": {
    "defaults": {
      "type": "size",
      "height": 100
    },
    "keys": ["height"]
  },
  "text": {
    "defaults": {
      "type": "text",
      "textColor": "#000000",
      "fontSize": 16
    },
    "keys": ["textColor", "fontSize"]
  }
}